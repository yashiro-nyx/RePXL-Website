# ─── Database (PostgreSQL via Prisma) ───────────────────────────────────────────
# You need TWO connection strings from your provider:
#   DATABASE_URL = POOLED connection (used by the app at runtime on Vercel)
#   DIRECT_URL   = DIRECT connection (used by `prisma migrate` / `db push`)
#
# ── Neon (recommended) — https://neon.tech ──
#   Dashboard → Connection Details. Copy BOTH:
#     • the string whose host contains "-pooler"  → DATABASE_URL
#     • the string WITHOUT "-pooler"              → DIRECT_URL
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/repixl?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/repixl?sslmode=require"
#
# ── Supabase — https://supabase.com ──
#   Project Settings → Database → Connection string
#     • "Transaction" pooler (port 6543) + "?pgbouncer=true&connection_limit=1" → DATABASE_URL
#     • "Direct connection" (port 5432)                                         → DIRECT_URL
#
# ── Local Postgres (dev only) ──
#   Both can point at the same local instance:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repixl?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/repixl?schema=public"
DATABASE_URL="postgresql://user:pass@host-pooler:5432/repixl?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/repixl?sslmode=require"

# ─── Auth (required) ─────────────────────────────────────────────────────────────
# Session cookies are HMAC-signed with NEXTAUTH_SECRET.
# Generate one with:  openssl rand -base64 32   (or: npx auth secret)
NEXTAUTH_SECRET="paste-a-32-byte-random-string-here"
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Site URL — used to build reset links in emails ──────────────────────────────
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── PayMongo (payment gateway — optional; plug-and-play) ────────────────────────
# Get keys at: PayMongo Dashboard → Developers → API Keys (use TEST keys first).
# When PAYMONGO_SECRET_KEY is set, checkout redirects to PayMongo hosted payment.
# When unset, checkout uses the built-in demo/direct-order flow.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
# Public (safe to expose) key — only used if you build a custom card form.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
# Webhook signing secret from: Dashboard → Developers → Webhooks (whsk_...).
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
# Tells the client to use the PayMongo redirect flow. Set to "true" once keys are configured.
NEXT_PUBLIC_PAYMONGO_ENABLED=false

# ─── Email (optional — Gmail SMTP for password-reset / newsletter / contact) ─────
# App Password from: myaccount.google.com → Security → App Passwords
# If left as placeholders, emails are logged to the server console instead of sent.
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
