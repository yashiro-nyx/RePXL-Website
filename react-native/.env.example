# Public origin of the RePXL Next.js backend API (do not include trailing slash or /api).
# For production:
EXPO_PUBLIC_API_BASE_URL=https://repxlph.vercel.app
# For local development on physical device via LAN Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://<YOUR_LOCAL_IP>:3000
# For iOS Simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# For Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Optional: EAS project ID used to obtain an Expo push token.
EXPO_PUBLIC_EXPO_PROJECT_ID=

# Optional: Supabase Public URL and Anon Key (for client-side Storage/Realtime if needed)
EXPO_PUBLIC_SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
