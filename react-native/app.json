{
  "expo": {
    "name": "RePXL",
    "slug": "repxl",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.repxl.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d"
      },
      "package": "com.repxl.mobile"
    },
    "scheme": "repxl",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
